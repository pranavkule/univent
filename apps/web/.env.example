# mock uses browser-local data; live calls the API Gateway URL below.
VITE_API_MODE=mock
VITE_API_URL=

# mock keeps the browser-local demo accounts; cognito uses AWS Cognito.
VITE_AUTH_MODE=mock

# Production student self sign-up is limited to this exact email domain.
VITE_ALLOWED_EMAIL_DOMAIN=ves.ac.in

# Set to true only when running scripts/dev-api.js locally; enables dev identity headers.
VITE_DEV_AUTH=false

# Required when VITE_AUTH_MODE=cognito. Copy these from the SAM stack outputs.
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
