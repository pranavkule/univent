# API Gateway URL from the deployed SAM stack outputs.
VITE_API_URL=

# Student self sign-up is limited to this exact email domain.
VITE_ALLOWED_EMAIL_DOMAIN=ves.ac.in

# Cognito values from the SAM stack outputs.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Only for confirming legacy organization accounts created before admin-assisted applications.
VITE_COGNITO_ORGANIZATION_APPLICANT_CLIENT_ID=
